{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "radar-site",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "assets": { "directory": "./dist", "binding": "ASSETS" },

  // Cloudflare Access application guarding /admin (not secret: the middleware
  // verifies each request's Access JWT signature against the team's public keys).
  "vars": {
    "ACCESS_AUD": "4c6876fe1d52a71edf75ed851d0cddd7ead9384fb34b297082363df1f61c1b06",
    "ACCESS_TEAM_DOMAIN": "andyshinn.cloudflareaccess.com"
  },

  // The admin status panel enqueues fetch and classify jobs; radar-ingest consumes them.
  "queues": {
    "producers": [
      { "binding": "FETCH_QUEUE", "queue": "radar-fetch" },
      { "binding": "CLASSIFY_QUEUE", "queue": "radar-classify" }
    ]
  },

  // Extracted article text (written by radar-ingest), shown in the admin review queue.
  "r2_buckets": [{ "binding": "ARTICLES", "bucket_name": "radar-articles" }],

  // database_id is written by .github/workflows/bootstrap.yml.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "radar",
      "database_id": "1857c1e6-46e4-4de4-bff2-d8148d5a3880",
      "migrations_dir": "../../migrations"
    }
  ]
}
