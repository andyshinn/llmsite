---
import Icon from "../components/Icon.astro";
import Base from "./Base.astro";

interface Props {
  title: string;
  section?: "queue" | "tools" | "status" | "settings";
}
const { title, section } = Astro.props;
const email = Astro.locals.adminEmail;
const tabs = [
  { id: "queue", href: "/admin/queue", label: "Queue", icon: "inbox" },
  { id: "tools", href: "/admin/tools", label: "Tools", icon: "wrench" },
  { id: "status", href: "/admin/status", label: "Status", icon: "chartBar" },
  { id: "settings", href: "/admin/settings", label: "Settings", icon: "cog" },
] as const;
---

<Base title={`${title} · Slop Bucket admin`} noindex>
  <header class="sticky top-0 z-10 border-b border-gray-200 bg-white">
    <div class="mx-auto flex h-14 max-w-2xl items-center justify-between gap-4 px-4">
      <a href="/admin/queue" class="flex items-center gap-2 font-semibold text-gray-900">
        <Icon name="inbox" class="size-5 text-brand-600" />
        Slop Bucket admin
      </a>
      {email && <span class="truncate text-sm text-gray-500">{email}</span>}
    </div>
    <nav class="mx-auto grid max-w-2xl grid-cols-4 px-2" aria-label="Admin sections">
      {tabs.map((t) => (
        <a
          href={t.href}
          aria-current={section === t.id ? "page" : undefined}
          class={`flex min-h-11 items-center justify-center gap-1.5 border-b-2 text-sm font-medium ${section === t.id ? "border-brand-600 text-brand-700" : "border-transparent text-gray-500 hover:text-gray-900"}`}
        >
          <Icon name={t.icon} class="size-4" />
          {t.label}
        </a>
      ))}
    </nav>
  </header>
  <main class="mx-auto max-w-2xl px-4 pt-4 pb-40">
    <slot />
  </main>
</Base>
