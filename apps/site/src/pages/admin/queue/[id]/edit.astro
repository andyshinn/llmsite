---
import { env } from "cloudflare:workers";
import { POST_TYPES, getSetting } from "@radar/core";
import Notice from "../../../../components/Notice.astro";
import Admin from "../../../../layouts/Admin.astro";
import { ReviewError, editPost, getQueueItem, parseEditForm } from "../../../../lib/review.ts";
import { btnPrimary, btnSecondary, card, input, label } from "../../../../lib/ui.ts";

const id = Number(Astro.params.id);
if (!Number.isInteger(id) || id <= 0) return Astro.redirect("/admin/queue", 302);

let error: string | null = null;
let submitted: Record<string, unknown> | null = null;
let useInPrompt = true;
if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  submitted = parseEditForm(form);
  useInPrompt = form.get("use_in_prompt") === "on";
  try {
    await editPost(env.DB, id, submitted, useInPrompt);
    return Astro.redirect(`/admin/queue?after=${id}`, 303);
  } catch (err) {
    if (!(err instanceof ReviewError)) throw err;
    error = err.message;
    Astro.response.status = 422;
  }
}

const item = await getQueueItem(env.DB, id);
if (!item || item.post.status !== "queued") return Astro.redirect(`/admin/queue/${id}`, 302);
const categories = await getSetting(env.DB, "categories");
// Re-show what was submitted after an error; otherwise start from the model's output.
const v: Record<string, unknown> = submitted ?? item.classification ?? { is_ai_dev_tool: true, post_type: "launch", category: "other" };
const s = (k: string) => (v[k] === null || v[k] === undefined ? "" : String(v[k]));
const tags = Array.isArray(v.tags) ? v.tags.join(", ") : "";
---

<Admin title="Edit post">
  <a href={`/admin/queue/${id}`} class="text-sm font-medium text-brand-700">← Back to post</a>
  <h1 class="mt-2 text-lg font-semibold">Edit and approve</h1>
  <p class="mt-1 text-sm text-gray-600 break-words">{item.post.title}</p>

  {error && <div class="mt-4"><Notice tone="error">{error}</Notice></div>}

  <form method="post" class={`${card} mt-4 space-y-5 p-4`}>
    <fieldset>
      <legend class={label}>Is this an AI coding tool?</legend>
      <div class="mt-2 grid grid-cols-2 gap-2">
        {[["true", "Yes"], ["false", "No, out of scope"]].map(([value, text]) => (
          <label class="flex min-h-11 items-center gap-2 rounded-lg px-3 ring-1 ring-gray-300 has-checked:bg-brand-50 has-checked:ring-brand-600">
            <input type="radio" name="is_ai_dev_tool" value={value} checked={String(v.is_ai_dev_tool !== false) === value} class="size-4 accent-brand-600" />
            {text}
          </label>
        ))}
      </div>
    </fieldset>

    <div class="grid grid-cols-2 gap-3">
      <div>
        <label for="post_type" class={label}>Post type</label>
        <select id="post_type" name="post_type" class={`${input} mt-1`}>
          {POST_TYPES.map((t) => <option value={t} selected={s("post_type") === t}>{t}</option>)}
        </select>
      </div>
      <div>
        <label for="category" class={label}>Category</label>
        <select id="category" name="category" class={`${input} mt-1`}>
          {categories.map((cat) => <option value={cat} selected={s("category") === cat}>{cat}</option>)}
        </select>
      </div>
    </div>

    <div>
      <label for="tool_name" class={label}>Tool name</label>
      <input id="tool_name" name="tool_name" value={s("tool_name")} class={`${input} mt-1`} autocomplete="off" />
    </div>
    <div>
      <label for="github_repo" class={label}>GitHub repo</label>
      <input id="github_repo" name="github_repo" value={s("github_repo")} placeholder="owner/repo" class={`${input} mt-1`} autocomplete="off" autocapitalize="off" />
    </div>
    <div>
      <label for="homepage_url" class={label}>Homepage</label>
      <input id="homepage_url" name="homepage_url" value={s("homepage_url")} placeholder="https://…" inputmode="url" class={`${input} mt-1`} autocomplete="off" autocapitalize="off" />
    </div>
    <div class="grid grid-cols-2 gap-3">
      <div>
        <label for="version" class={label}>Version</label>
        <input id="version" name="version" value={s("version")} class={`${input} mt-1`} autocomplete="off" />
      </div>
      <fieldset>
        <legend class={label}>Open source</legend>
        <div class="mt-1 grid grid-cols-2 gap-2">
          {[["true", "Yes"], ["false", "No"]].map(([value, text]) => (
            <label class="flex min-h-11 items-center gap-2 rounded-lg px-3 ring-1 ring-gray-300 has-checked:bg-brand-50 has-checked:ring-brand-600">
              <input type="radio" name="is_open_source" value={value} checked={String(v.is_open_source === true) === value} class="size-4 accent-brand-600" />
              {text}
            </label>
          ))}
        </div>
      </fieldset>
    </div>
    <div>
      <label for="tags" class={label}>Tags <span class="font-normal text-gray-500">(comma-separated)</span></label>
      <input id="tags" name="tags" value={tags} class={`${input} mt-1`} autocomplete="off" autocapitalize="off" />
    </div>
    <div>
      <label for="description" class={label}>Description <span class="font-normal text-gray-500">(under 140 characters)</span></label>
      <textarea id="description" name="description" rows="3" maxlength="140" class={`${input} mt-1`}>{s("description")}</textarea>
    </div>

    <label class="flex min-h-11 items-center gap-3 text-sm text-gray-700">
      <input type="checkbox" name="use_in_prompt" checked={useInPrompt} class="size-5 rounded border-gray-300 accent-brand-600" />
      Use as a few-shot example
    </label>

    <div class="grid grid-cols-2 gap-3">
      <a href={`/admin/queue/${id}`} class={btnSecondary}>Cancel</a>
      <button type="submit" class={btnPrimary}>Save</button>
    </div>
    <p class="text-xs text-gray-500">Saving approves the post, or rejects it if you marked it out of scope or as a roundup.</p>
  </form>
</Admin>
