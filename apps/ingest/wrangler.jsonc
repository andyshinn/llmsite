{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "radar-ingest",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "observability": { "enabled": true },

  // Daily run (UTC).
  "triggers": { "crons": ["0 6 * * *"] },

  // database_id is written by .github/workflows/bootstrap.yml.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "radar",
      "database_id": "1857c1e6-46e4-4de4-bff2-d8148d5a3880",
      "migrations_dir": "../../migrations"
    }
  ],

  // Extracted article text, keyed by post ID.
  "r2_buckets": [{ "binding": "ARTICLES", "bucket_name": "radar-articles" }],

  "ai": { "binding": "AI" },

  // Every Workers AI call goes through this AI Gateway, which enforces the daily
  // spend limit in infra/ai-gateway.json (applied by deploy.yml).
  "vars": { "AI_GATEWAY_ID": "radar" },

  "queues": {
    "producers": [
      { "binding": "FETCH_QUEUE", "queue": "radar-fetch" },
      { "binding": "CLASSIFY_QUEUE", "queue": "radar-classify" }
    ],
    "consumers": [
      // Gentle on source APIs; a 90-day HN backfill fans out into 90 of these.
      { "queue": "radar-fetch", "max_batch_size": 1, "max_retries": 3, "max_concurrency": 2 },
      // One post at a time: the classifier model (a Workers Paid model) is limited to
      // 20 requests/minute, and one call takes ~3.5s. Concurrent tool creation is
      // still handled in the resolver.
      { "queue": "radar-classify", "max_batch_size": 1, "max_retries": 3, "max_concurrency": 1 }
    ]
  }
}
